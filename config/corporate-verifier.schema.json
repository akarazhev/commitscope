{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["verdicts"],
  "properties": {
    "verdicts": {
      "type": "array", "maxItems": 30,
      "$comment": "Runtime validation requires exact-once coverage of every Hunter ID and no others.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["finding_id", "status", "reason", "evidence"],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^AI-[0-9]{3}$"},
          "status": {"type": "string", "enum": ["source_supported", "rejected", "unresolved"]},
          "reason": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "evidence": {"type": "string", "minLength": 1, "pattern": "\\S"}
        }
      }
    }
  }
}
